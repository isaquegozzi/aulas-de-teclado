# Configuração (copie para .env)

# Banco de dados PostgreSQL (use Neon, Vercel Postgres ou Supabase na nuvem)
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Chaves VAPID para notificações push - gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@exemplo.com"

# Segurança
SESSION_SECRET="gerar-comprida-e-aleatoria"
# IMPORTANTE: o hash bcrypt contém $ — escape cada $ com \$ (o script hash:password já faz isso)
ADMIN_PASSWORD_HASH="gerar-com: npm run hash:password -- SUASENHA"
CRON_SECRET="segredo-para-o-cron"

# URL do site (para notificações)
APP_URL="http://localhost:3000"